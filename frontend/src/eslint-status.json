\"7\");\n\n  const { data: products, isLoading } = useQuery({\n    queryKey: [\"new-arrivals\", dateRange],\n    queryFn: () => fetchNewArrivals(parseInt(dateRange)),\n  });\n\n  return (\n    <div className=\"container mx-auto px-4 py-8 max-w-7xl\">\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4\">\n        <div>\n          <h1 className=\"text-3xl font-bold flex items-center gap-2\">\n            <Sparkles className=\"h-6 w-6 text-primary\" />\n            New Arrivals\n          </h1>\n          <p className=\"text-muted-foreground mt-1\">\n            Discover our latest fashion collections\n          </p>\n        </div>\n\n        <Select value={dateRange} onValueChange={setDateRange}>\n          <SelectTrigger className=\"w-48\">\n            <SelectValue placeholder=\"Filter by date\" />\n          </SelectTrigger>\n          <SelectContent>\n            <SelectItem value=\"7\">Last 7 Days</SelectItem>\n            <SelectItem value=\"14\">Last 14 Days</SelectItem>\n            <SelectItem value=\"30\">Last 30 Days</SelectItem>\n          </SelectContent>\n        </Select>\n      </div>\n\n      {isLoading ? (\n        <div className=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4\">\n          {Array.from({ length: 8 }).map((_, i) => (\n            <Card key={i} className=\"overflow-hidden\">\n              <div className=\"aspect-square bg-muted animate-pulse\" />\n              <CardContent className=\"p-4 space-y-2\">\n                <div className=\"h-4 w-3/4 bg-muted animate-pulse rounded\" />\n                <div className=\"h-4 w-1/4 bg-muted animate-pulse rounded\" />\n              </CardContent>\n            </Card>\n          ))}\n        </div>\n      ) : products && products.length > 0 ? (\n        <>\n          <p className=\"text-sm text-muted-foreground mb-4\">\n            {products.length} product(s) found\n          </p>\n          <div className=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4\">\n            {products.map((product) => (\n              <div key={product.id} className=\"relative\">\n                <ProductCard\n                  product={{\n                    id: product.id,\n                    name: product.name,\n                    price: product.basePrice,\n                    image: product.images?.[0],\n                    category: product.category || \"uncategorized\",\n                    isNew: true,\n                  }}\n                />\n                <span className=\"absolute top-2 left-2 bg-primary text-primary-foreground text-xs font-bold px-2 py-1 rounded\">\n                  NEW\n                </span>\n              </div>\n            ))}\n          </div>\n        </>\n      ) : (\n        <Card>\n          <CardContent className=\"py-12 text-center\">\n            <Sparkles className=\"h-12 w-12 mx-auto text-muted-foreground mb-4\" />\n            <p className=\"text-muted-foreground\">No new arrivals in this period</p>\n          </CardContent>\n        </Card>\n      )}\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\CodeFile\\Fashion-Graduation-Thesis\\.kilo\\worktrees\\educated-paddleboat\\frontend\\src\\app\\(shop)\\oauth2\\redirect\\page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\CodeFile\\Fashion-Graduation-Thesis\\.kilo\\worktrees\\educated-paddleboat\\frontend\\src\\app\\(shop)\\page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\CodeFile\\Fashion-Graduation-Thesis\\.kilo\\worktrees\\educated-paddleboat\\frontend\\src\\app\\(shop)\\payment\\callback\\page.tsx","messages":[],"suppressedMessages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'setStatus' is assigned a 