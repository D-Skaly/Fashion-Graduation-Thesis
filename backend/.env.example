# Google OAuth2 Credentials (cho chức năng Login with Google)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Google Gemini API Key (cho chức năng AI Search / Chat)
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-GEMINI_API_KEY=AIzaSyBKE4ZiTR6EXtK7gOEiTfgRE9xx7TPbBho

# Bật/tắt AI Assistant runtime (production nên bật explicit để tránh lỗi cấu hình)
AI_ASSISTANT_ENABLED=false

# AI assistant guardrails & resiliency
AI_ASSISTANT_MAX_MESSAGE_LENGTH=1000
AI_ASSISTANT_TIMEOUT_MS=8000
AI_ASSISTANT_RETRY_MAX_ATTEMPTS=3
AI_ASSISTANT_RETRY_BACKOFF_MS=250

# AI assistant rate limiting
AI_ASSISTANT_RATE_LIMIT_ENABLED=true
AI_ASSISTANT_RATE_LIMIT_MAX_REQUESTS=20
AI_ASSISTANT_RATE_LIMIT_WINDOW_SECONDS=60
