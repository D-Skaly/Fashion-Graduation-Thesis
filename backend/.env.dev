SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=dev@fashion.local
SPRING_MAIL_PASSWORD=devpassword
SPRING_MAIL_FROM=noreply@fashion.local
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_SMTP_STARTTLS_ENABLE=false

