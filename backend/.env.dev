# ============================================
# DEVELOPMENT ENVIRONMENT
# ============================================

# --- Profile ---
SPRING_PROFILES_ACTIVE=dev

# --- Database (dev database) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/fashion_db_dev
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=password

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=dev-secret-key-not-for-production
JWT_EXPIRATION=86400000

# --- Refresh Token ---
REFRESH_TOKEN_EXPIRATION=604800000
MAX_TOKENS_PER_USER=10

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Google Gemini AI ---
GEMINI_API_KEY=your-gemini-api-key
AI_ENABLED=false
AI_MODEL=gemini-1.5-flash

# --- AI Assistant ---
AI_ASSISTANT_ENABLED=false
AI_ASSISTANT_MAX_MESSAGE_LENGTH=1000
AI_ASSISTANT_RETRY_MAX_ATTEMPTS=3
AI_ASSISTANT_RETRY_BACKOFF_MS=250
AI_ASSISTANT_TIMEOUT_MS=8000
AI_ASSISTANT_RATE_LIMIT_ENABLED=false

# --- Mail ---
