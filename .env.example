# ============================================
# FASHION E-COMMERCE - DEVELOPMENT ENVIRONMENT
# Copy file này thành backend/.env và frontend/.env.local
# ============================================

# ============================================
# BACKEND CONFIGURATION (backend/.env)
# ============================================

# --- Profile ---
SPRING_PROFILES_ACTIVE=dev

# --- Database (dev database) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/fashion_db_dev
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=password

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_EXPIRATION=86400000

# --- Refresh Token ---
REFRESH_TOKEN_EXPIRATION=604800000
MAX_TOKENS_PER_USER=10

# --- Google OAuth (Optional) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Google Gemini AI (Optional) ---
GEMINI_API_KEY=your-gemini-api-key
AI_ENABLED=false
AI_MODEL=gemini-1.5-flash

# --- AI Assistant (Optional) ---
AI_ASSISTANT_ENABLED=false

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- MinIO Storage (Optional - cần chạy MinIO service) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fashion-images-dev
MINIO_URL_EXPIRY=3600

# ============================================
# FRONTEND CONFIGURATION (frontend/.env.local)
# ============================================

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
